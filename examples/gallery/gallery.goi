// The Material 3 component gallery, split into one page per category.
//
// Navigation follows the M3 window size classes: a bottom navigation bar in the
// compact layout, a navigation rail from 640dp up. The app-bar menu opens a
// modal drawer that lists the same categories, so the pattern works even when a
// bar or rail is off screen.
//
// Every page is an independent scrolling column; Go shows one at a time.

bridge {
	rows []galleryRow
}

type galleryRow {
	title      string
	supporting string
}

Window {
	id:    main
	title: "Material 3 components"
	theme: app.systemMode

	Stack {
		Row {
			spacing: 0

			// ---- medium and expanded: rail
			NavigationRail {
				id:            rail
				visible:       { base: false, sm: true }
				// Room under the theme switch, so it does not touch the edge.
				paddingBottom: 16

				NavigationItem {
					label:    "Buttons"
					icon:     smart_button
					selected: true
				}

				NavigationItem {
					label: "Inputs"
					icon:  tune
				}

				NavigationItem {
					label: "Surfaces"
					icon:  layers
				}

				NavigationItem {
					label: "Feedback"
					icon:  notifications
				}

				NavigationItem {
					label: "Layout"
					icon:  dashboard
				}

				NavigationItem {
					label: "Motion"
					icon:  animation
				}

				// The theme lives at the bottom of the rail, where a rail puts its
				// own actions, instead of floating in the app bar.
				Rectangle {
					flex: 1
				}

				Switch {
					id:        railTheme
					width:     52
					alignSelf: center
					checked:   app.dark
					// Checked means dark, so the checked thumb carries the moon.
					iconOn:    dark_mode
					iconOff:   light_mode
				}
			}

			Column {
				spacing: 0
				flex:    1

				TopAppBar {
					id:    appbar
					label: "Buttons"
					// The hamburger is the compact-only way into the drawer: at
					// sm and up the rail is on screen, so the bar drops it.
					icon:  { base: menu, sm: "" }
				}

				// ---- one page at a time
				Stack {
					flex: 1

					// ============================================== buttons
					Column {
						id:             pageButtons
						scroll:         true
						spacing:        24
						padding:        { base: 16, md: 24, lg: 32, xl: 64 }
						crossAxisAlign: start

						Column {
							spacing: 10

							Text {
								text: "Buttons"
								role: "titleMedium"
							}

							Wrap {
								spacing: 8

								Button {
									label: "Filled"
								}

								Button {
									label:   "Tonal"
									variant: tonal
								}

								Button {
									label:   "Outlined"
									variant: outlined
								}

								Button {
									label:   "Text"
									variant: text
								}

								Button {
									label:   "Elevated"
									variant: elevated
								}

								Button {
									label: "With icon"
									icon:  add
								}

								Button {
									label:    "Disabled"
									disabled: true
								}
							}
						}

						Column {
							spacing: 10

							Text {
								text: "Icon buttons"
								role: "titleMedium"
							}

							Wrap {
								spacing: 8

								IconButton {
									icon: favorite
								}

								IconButton {
									icon:    favorite
									variant: filled
								}

								IconButton {
									icon:    favorite
									variant: tonal
								}

								IconButton {
									icon:    favorite
									variant: outlined
								}
							}
						}

						Column {
							spacing: 10

							Text {
								text: "Button group"
								role: "titleMedium"
							}

							ButtonGroup {
								spacing: 8

								Button {
									label:   "Back"
									icon:    arrow_back
									variant: tonal
								}

								Button {
									label:   "Next"
									icon:    arrow_forward
									variant: tonal
								}
							}

							Text {
								text: "A row that shares one gap and one alignment, so the actions read as a set."
								role: "bodySmall"
							}
						}

						Column {
							spacing: 10

							Text {
								text: "FAB"
								role: "titleMedium"
							}

							Wrap {
								spacing: 16

								FAB {
									icon: edit
									size: sm
								}

								FAB {
									icon: add
								}

								FAB {
									label:   "Compose"
									icon:    edit
									variant: extended
								}
							}
						}

						Column {
							spacing: 10

							Text {
								text: "FAB menu"
								role: "titleMedium"
							}

							FABMenu {
								id:       fabMenu
								icon:     add
								expanded: true

								FAB {
									icon: edit
									size: sm
								}

								FAB {
									icon: photo
									size: sm
								}

								FAB {
									icon: share
									size: sm
								}
							}

							Text {
								text: "The actions stack above the FAB while expanded; a closed menu has none."
								role: "bodySmall"
							}
						}

						Column {
							spacing: 10

							Text {
								text: "Split button"
								role: "titleMedium"
							}

							SplitButton {
								label: "Split"
								icon:  add
								width: 200
							}
						}

						Column {
							spacing: 10

							Text {
								text: "Segmented button: radio"
								role: "titleMedium"
							}

							Row {
								spacing: 0

								SegmentedButton {
									label:   "Day"
									width:   84
									variant: single
								}

								SegmentedButton {
									label:    "Week"
									width:    84
									variant:  single
									selected: true
								}

								SegmentedButton {
									label:   "Month"
									width:   96
									variant: single
								}
							}

							Text {
								text: "variant: single keeps exactly one selected."
								role: "bodySmall"
							}
						}

						Column {
							spacing: 10

							Text {
								text: "Segmented button: checkbox"
								role: "titleMedium"
							}

							Row {
								spacing: 0

								SegmentedButton {
									label: "Bold"
									width: 84
								}

								SegmentedButton {
									label:    "Italic"
									width:    84
									selected: true
								}

								SegmentedButton {
									label: "Underline"
									width: 108
								}
							}

							Text {
								text: "The default toggles each segment on its own; clicking a selected one clears it."
								role: "bodySmall"
							}
						}
					}

					// =============================================== inputs
					Column {
						id:             pageInputs
						visible:        false
						scroll:         true
						spacing:        24
						padding:        { base: 16, md: 24, lg: 32, xl: 64 }
						crossAxisAlign: start

						Column {
							spacing: 10

							Text {
								text: "Selection"
								role: "titleMedium"
							}

							Checkbox {
								id:      check
								label:   "Checkbox"
								checked: true
								width:   220
							}

							RadioButton {
								label:   "Radio button"
								checked: true
								width:   220
							}

							Switch {
								id:      switchOn
								label:   "Switch"
								checked: true
								width:   220
							}

							// iconOn/iconOff override icon; empty means no glyph.
							Switch {
								label:   "Switch with icons"
								checked: true
								iconOn:  check
								iconOff: close
								width:   240
							}
						}

						Column {
							spacing: 10

							Text {
								text: "Slider"
								role: "titleMedium"
							}

							Slider {
								id:    slider
								value: 0.4
								min:   0
								max:   1
								width: { base: 280, md: 360 }
							}

							Text {
								text: "Drag the handle, or use the arrow keys."
								role: "bodySmall"
							}
						}

						Column {
							spacing: 10

							Text {
								text: "Chips"
								role: "titleMedium"
							}

							Wrap {
								spacing: 8

								Chip {
									label: "Assist"
									icon:  event
								}

								Chip {
									label:    "Filter"
									variant:  filter
									selected: true
								}

								Chip {
									label:   "Input"
									variant: input
								}

								Chip {
									label:   "Suggestion"
									variant: suggestion
								}
							}
						}

						Column {
							spacing: 10

							Text {
								text: "Text fields"
								role: "titleMedium"
							}

							TextField {
								id:          field
								label:       "Label"
								placeholder: "Filled text field"
								variant:     filled
								width:       { base: 280, md: 360 }
							}

							TextField {
								label:       "Label"
								placeholder: "Outlined field"
								variant:     outlined
								width:       { base: 280, md: 360 }
							}

							TextField {
								label:   "Email"
								text:    "user@example.com"
								icon:    mail
								variant: filled
								width:   { base: 280, md: 360 }
							}

							TextField {
								label:       "Supporting text"
								placeholder: "With a helper line"
								supporting:  "Shown under the field"
								variant:     outlined
								width:       { base: 280, md: 360 }
							}
						}

						Column {
							spacing: 10

							Text {
								text: "Search bar"
								role: "titleMedium"
							}

							SearchBar {
								placeholder: "Search components"
								width:       { base: 280, md: 400 }
							}

							Text {
								text: "Click it and type: the value scrolls and selects."
								role: "bodySmall"
							}
						}

						Column {
							spacing: 10

							Text {
								text: "Text area"
								role: "titleMedium"
							}

							TextArea {
								id:          notes
								label:       "Notes"
								placeholder: "Enter starts a new line"
								text:        "A multiline field: Enter adds a line, Home and End work per line, and the caret scrolls when the text outgrows the box."
								supporting:  "supporting text sits under the field"
								width:       { base: 300, md: 420 }
								height:      140
							}
						}

						Column {
							spacing: 10

							Text {
								text: "Code"
								role: "titleMedium"
							}

							Code {
								language: go
								showCopy: true
								width:    { base: 300, md: 520 }
								text:     "// A highlighted block\nfunc bind(w *ui.Window) error {\n\tbtn := ui.MustByID[*ui.Button](w, \"go\")\n\tbtn.OnClick(func(ui.ClickEvent) {\n\t\tfmt.Println(\"clicked\")\n\t})\n\treturn nil\n}"
							}

							Code {
								language: py
								variant:  outlined
								width:    { base: 300, md: 520 }
								text:     "# spans: keywords, strings, numbers, comments\nfor i in range(3):\n    print(\"easing\", i, 0.5)"
							}
						}

						Column {
							spacing: 10

							Text {
								text: "Date picker"
								role: "titleMedium"
							}

							Text {
								id:   dateValue
								text: "No date picked"
								role: "bodySmall"
							}

							DatePicker {
								id:    datePicker
								label: "Select date"
							}
						}

						Column {
							spacing: 10

							Text {
								text: "Time picker"
								role: "titleMedium"
							}

							Text {
								id:   timeValue
								text: "No time picked"
								role: "bodySmall"
							}

							TimePicker {
								id:    timePicker
								label: "Select time"
							}
						}
					}

					// ============================================= surfaces
					Column {
						id:             pageSurfaces
						visible:        false
						scroll:         true
						spacing:        24
						padding:        { base: 16, md: 24, lg: 32, xl: 64 }
						crossAxisAlign: start

						Column {
							spacing: 12

							Text {
								text: "Cards"
								role: "titleMedium"
							}

							Grid {
								columns: { base: 1, md: 2, lg: 3 }
								spacing: 12

								Card {
									label:      "Elevated"
									supporting: "Surface container low"
									height:     96
								}

								Card {
									label:      "Filled"
									supporting: "Highest container"
									variant:    filled
									height:     96
								}

								Card {
									label:      "Outlined"
									supporting: "1dp outline"
									variant:    outlined
									height:     96
								}
							}
						}

						Column {
							spacing: 10

							Text {
								text: "Image"
								role: "titleMedium"
							}

							Wrap {
								spacing: 12

								// cover crops to fill the box; contain letterboxes.
								Image {
									src:    "sample.jpg"
									width:  180
									height: 120
									radius: 12
								}

								Image {
									src:        "sample.jpg"
									fit:        contain
									width:      180
									height:     120
									radius:     12
									background: surfaceContainerHigh
								}

								Image {
									src:    "sample.jpg"
									fit:    fill
									width:  180
									height: 120
									radius: 12
								}
							}

							Text {
								text:  "PNG, JPEG and GIF, decoded once and packed into one GPU atlas. fit picks cover, contain or fill."
								role:  "bodySmall"
								wrap:  true
								width: { base: 280, md: 420 }
							}
						}

						Column {
							spacing: 10

							Text {
								text: "Carousel"
								role: "titleMedium"
							}

							Carousel {
								height: 200

								Card {
									width:      220
									label:      "One"
									supporting: "Scroll sideways"
									variant:    filled
								}

								Card {
									width:      220
									label:      "Two"
									supporting: "Drag or use the wheel"
								}

								Card {
									width:      220
									label:      "Three"
									supporting: "The strip clips"
									variant:    outlined
								}

								Card {
									width:      220
									label:      "Four"
									supporting: "Last item"
									variant:    filled
								}
							}

							Text {
								text: "A horizontally scrolling strip: the wheel over it moves it sideways."
								role: "bodySmall"
							}
						}

						Column {
							spacing: 10

							Text {
								text: "List"
								role: "titleMedium"
							}

							List {
								width: { base: 100%, md: 420 }

								ListItem {
									label:        "List item"
									icon:         person
									trailingIcon: chevron_right
								}

								ListItem {
									label:      "Two lines"
									supporting: "Supporting text"
									icon:       photo
								}

								Divider {}

								ListItem {
									label:    "Selected"
									icon:     star
									selected: true
								}
							}
						}

						Column {
							spacing: 10

							Text {
								text: "Tabs"
								role: "titleMedium"
							}

							Tabs {
								width: { base: 100%, md: 420 }

								Tab {
									label:    "Overview"
									selected: true
								}

								Tab {
									label: "Specs"
								}

								Tab {
									label: "Details"
								}
							}
						}

						Column {
							spacing: 10

							Text {
								text: "Menu"
								role: "titleMedium"
							}

							Menu {
								width: 260

								MenuItem {
									label: "Cut"
									icon:  content_cut
								}

								MenuItem {
									label: "Copy"
									icon:  content_copy
								}

								MenuItem {
									label: "Paste"
									icon:  content_paste
								}

								Divider {}

								MenuItem {
									label: "More…"
									icon:  more_horiz
								}
							}
						}
					}

					// ============================================= feedback
					Column {
						id:             pageFeedback
						visible:        false
						scroll:         true
						spacing:        24
						padding:        { base: 16, md: 24, lg: 32, xl: 64 }
						crossAxisAlign: start

						Column {
							spacing: 10

							Text {
								text: "Progress"
								role: "titleMedium"
							}

							LinearProgress {
								value: 0.6
								width: { base: 280, md: 420 }
							}

							Row {
								spacing:        24
								crossAxisAlign: center

								CircularProgress {
									value: 0.65
								}

								LoadingIndicator {}
							}
						}

						Column {
							spacing: 10

							Text {
								text: "Badges"
								role: "titleMedium"
							}

							Wrap {
								spacing: 16

								Badge {}

								Badge {
									label: "12"
								}

								Badge {
									label: "99+"
								}
							}
						}

						Column {
							spacing: 10

							Text {
								text: "Dialog and sheets"
								role: "titleMedium"
							}

							Wrap {
								spacing: 16

								Dialog {
									label:      "Reset settings?"
									supporting: "This cannot be undone."
									width:      280
									height:     168
								}

								Column {
									spacing: 12

									BottomSheet {
										label:  "Bottom sheet"
										width:  280
										height: 132
									}

									SideSheet {
										label:  "Side sheet"
										width:  280
										height: 132
									}
								}
							}
						}

						Column {
							spacing: 10

							Text {
								text: "Snackbar and tooltip"
								role: "titleMedium"
							}

							Snackbar {
								label: "Saved to your library"
								width: { base: 280, md: 420 }
							}

							Tooltip {
								label: "Tooltip text"
								width: 120
							}
						}
					}

					// =============================================== layout
					Column {
						id:             pageLayout
						visible:        false
						scroll:         true
						spacing:        24
						padding:        { base: 16, md: 24, lg: 32, xl: 64 }
						crossAxisAlign: start

						// ---- axes: crossAxisAlign across, mainAxisAlign along.
						Column {
							spacing: 8

							Text {
								text: "Alignment axes"
								role: "titleMedium"
							}

							Text {
								text:  "crossAxisAlign places a child across the flow; mainAxisAlign places the run along it. Both default to start."
								role:  "bodySmall"
								wrap:  true
								width: { base: 280, md: 420 }
							}

							Row {
								id:             axisRow
								width:          { base: 280, md: 420 }
								height:         56
								spacing:        8
								crossAxisAlign: center
								mainAxisAlign:  spaceBetween

								Rectangle {
									width:      40
									height:     40
									radius:     8
									background: primary
								}

								Rectangle {
									width:      40
									height:     24
									radius:     8
									background: secondary
								}

								Rectangle {
									width:      40
									height:     32
									radius:     8
									background: tertiary
								}
							}

							Column {
								width:          { base: 280, md: 420 }
								height:         96
								spacing:        6
								crossAxisAlign: center
								mainAxisAlign:  spaceAround

								Rectangle {
									width:      90
									height:     20
									radius:     6
									background: primaryContainer
								}

								Rectangle {
									width:      60
									height:     20
									radius:     6
									background: secondaryContainer
								}
							}
						}

						Column {
							spacing: 10

							Text {
								text: "Title bar"
								role: "titleMedium"
							}

							// The same design can carry both platforms: app.os picks
							// one at runtime. Here they are plain rows inside the
							// page; with titleBar: custom on the Window, a TitleBar
							// also drags the window and the outer edge resizes it.
							TitleBar {
								visible:        app.os == "linux"
								height:         40
								paddingLeft:    12
								paddingRight:   4
								spacing:        4
								crossAxisAlign: center
								background:     surfaceContainerHigh
								radius:         8

								Text {
									text: "Linux layout: buttons on the right"
									role: "labelMedium"
								}

								Rectangle {
									flex: 1
								}

								IconButton {
									icon:    remove
									variant: text
									size:    sm
								}

								IconButton {
									icon:    crop_square
									variant: text
									size:    sm
								}

								IconButton {
									icon:    close
									variant: text
									size:    sm
								}
							}

							TitleBar {
								visible:        app.os == "darwin"
								height:         40
								paddingLeft:    4
								paddingRight:   12
								spacing:        4
								crossAxisAlign: center
								background:     surfaceContainerHigh
								radius:         8

								IconButton {
									icon:    close
									variant: text
									size:    sm
								}

								IconButton {
									icon:    remove
									variant: text
									size:    sm
								}

								IconButton {
									icon:    crop_square
									variant: text
									size:    sm
								}

								Text {
									text: "macOS layout: buttons on the left"
									role: "labelMedium"
								}
							}

							Text {
								text:  "visible: app.os == \"linux\" picks a bar per platform; only one of the two above exists at runtime."
								role:  "bodySmall"
								wrap:  true
								width: { base: 280, md: 460 }
							}
						}

						Column {
							spacing: 10

							Text {
								text: "Toolbar"
								role: "titleMedium"
							}

							Toolbar {
								spacing: 4

								IconButton {
									icon: undo
								}

								IconButton {
									icon: redo
								}

								Divider {
									variant:     vertical
									height:      24
									marginLeft:  6
									marginRight: 6
								}

								IconButton {
									icon: format_bold
								}

								IconButton {
									icon: format_italic
								}

								IconButton {
									icon: format_underlined
								}

								Divider {
									variant:     vertical
									height:      24
									marginLeft:  6
									marginRight: 6
								}

								IconButton {
									icon: share
								}
							}

							Text {
								text: "A floating row of actions in one pill."
								role: "bodySmall"
							}
						}

						Column {
							spacing: 12

							Text {
								text: "ClipRRect"
								role: "titleMedium"
							}

							Row {
								spacing: 12

								ClipRRect {
									radius: 24
									width:  96
									height: 96

									Rectangle {
										background: primary
									}

									// The strip runs past the box and is cut at the
									// rounded edge, which is the whole point.
									Rectangle {
										width:      200
										height:     20
										marginTop:  60
										background: tertiary
									}
								}

								ClipRRect {
									radius: 8
									width:  96
									height: 96

									Image {
										src: "sample.jpg"
										fit: cover
									}
								}

								ClipRRect {
									radius: 48
									width:  96
									height: 96

									Image {
										src: "sample.jpg"
										fit: cover
									}
								}
							}

							Text {
								text:  "radius rounds the cut; a child wider than the box is clipped, not scaled."
								role:  "bodySmall"
								wrap:  true
								width: { base: 280, md: 460 }
							}
						}

						Column {
							spacing: 12

							Text {
								text: "Grid"
								role: "titleMedium"
							}

							Grid {
								columns: { base: 1, sm: 2, lg: 3 }
								spacing: 12

								Card {
									label:      "One"
									supporting: "base: 1 column"
									height:     88
									variant:    filled
								}

								Card {
									label:      "Two"
									supporting: "sm: 2 columns"
									height:     88
								}

								Card {
									label:      "Three"
									supporting: "lg: 3 columns"
									height:     88
									variant:    outlined
								}
							}
						}

						Column {
							spacing: 10

							Text {
								text: "Wrap"
								role: "titleMedium"
							}

							Wrap {
								spacing: 8

								Chip {
									label: "Wrap"
									icon:  event
								}

								Chip {
									label: "Second"
								}

								Chip {
									label: "Third"
								}

								Chip {
									label: "Fourth"
								}

								Chip {
									label: "Fifth"
								}

								Chip {
									label: "Sixth"
								}
							}
						}

						Column {
							spacing: 10

							Text {
								text: "Stack and positioned"
								role: "titleMedium"
							}

							Stack {
								width:  { base: 280, md: 420 }
								height: 200

								// A Card rather than a coloured Rectangle: the plate
								// has to follow the theme, and a Card is the M3
								// surface that does.
								Card {
									variant: filled
									radius:  16
								}

								Positioned {
									left: 16
									top:  16

									Card {
										label:      "left: 16"
										supporting: "top: 16"
										width:      190
										height:     84
										variant:    filled
									}
								}

								Positioned {
									right:  16
									bottom: 16

									Chip {
										label: "bottom right"
										icon:  star
									}
								}

								Positioned {
									left:       16
									right:      16
									bottom:     64
									height:     4
									background: primary
									radius:     2
								}
							}
						}

						Column {
							spacing: 10

							Text {
								text: "Expressions"
								role: "titleMedium"
							}

							Column {
								width:   320
								spacing: 8

								// Named roles instead of hex: these follow the scheme.
								Rectangle {
									id:         demoBase
									width:      240
									height:     10
									background: primary
									radius:     5
								}

								Rectangle {
									width:      demoBase.width / 2
									height:     10
									background: secondary
									radius:     5
								}

								Rectangle {
									width:      50%
									height:     10
									background: tertiary
									radius:     5
								}
							}

							Column {
								spacing: 6

								Text {
									text: "Conditional: the " + app.mode + " scheme is active."
									role: "bodyMedium"
								}

								Rectangle {
									width:      160
									height:     8
									radius:     4
									background: app.dark ? primaryContainer : inversePrimary
								}
							}

							Text {
								text: "A reference, a division, a comparison, a conditional and a percentage of the parent."
								role: "bodySmall"
								wrap: true
							}
						}

						Column {
							spacing: 10

							Text {
								text: "Visibility"
								role: "titleMedium"
							}

							Text {
								text:    "This line appears from sm (640dp) up."
								role:    "bodyMedium"
								visible: { base: false, sm: true }
							}

							Text {
								text:    "This one only below sm, and the layout closes the gap."
								role:    "bodyMedium"
								visible: { base: true, sm: false }
							}
						}

						Column {
							spacing: 8

							Text {
								text: "Type"
								role: "titleMedium"
							}

							Text {
								text: "Headline medium"
								role: "headlineMedium"
							}

							Text {
								text:   "Title large, weight 900"
								role:   "titleLarge"
								weight: 900
							}

							Text {
								text:   "Body large at 300"
								role:   "bodyLarge"
								weight: 300
							}

							Text {
								text:  "Body medium wraps when the column runs out, and the block reserves one line box for every line it draws. Resize the window to watch it reflow."
								role:  "bodyMedium"
								wrap:  true
								width: { base: 280, md: 420, lg: 560 }
							}
						}

						// ---- data: one for loop, rows from Go.
						Column {
							spacing: 8

							Text {
								text: "Data rows"
								role: "titleMedium"
							}

							Column {
								id:      dataList
								spacing: 6
								width:   { base: 280, md: 420 }

								for _, row := range bridge.rows {
									ListItem {
										label:      row.title
										supporting: row.supporting
										icon:       circle
									}
								}
							}

							Text {
								text:  "ui.SetData fills bridge.rows; the loop rebuilds when the list changes."
								role:  "bodySmall"
								wrap:  true
								width: { base: 280, md: 420 }
							}
						}

						// ---- conditional: a block switched by a Go-set bool.
						Column {
							spacing: 8

							Text {
								text: "Conditional block"
								role: "titleMedium"
							}

							Switch {
								id:      blockSwitch
								label:   "Show the wide layout"
								checked: true
							}

							if blockSwitch.checked {
								Card {
									variant: filled
									width:   { base: 280, md: 420 }

									Text {
										text: "The if arm is shown."
									}
								}
							} else {
								Text {
									id:    blockElseLabel
									text:  "The else arm is shown."
									color: onSurfaceVariant
								}
							}

							Text {
								text:  "Both arms are built; only the matching one is laid out, and the condition re-reads the switch every frame."
								role:  "bodySmall"
								wrap:  true
								width: { base: 280, md: 420 }
							}
						}

						// ---- repeat: one hidden template, copies added from Go.
						Column {
							spacing: 8

							Text {
								text: "Repeat"
								role: "titleMedium"
							}

							Column {
								id:      repeatList
								spacing: 6
								width:   { base: 280, md: 420 }

								ListItem {
									template: true
									label:    "Item"
									icon:     circle
								}
							}

							Text {
								text:  "Three rows built with ui.Fill from a template: true row; the template itself stays hidden."
								role:  "bodySmall"
								wrap:  true
								width: { base: 280, md: 420 }
							}
						}

						Column {
							spacing: 8

							Text {
								text: "Selectable text"
								role: "titleMedium"
							}

							Text {
								id:         selectableText
								text:       "Drag across this paragraph to select it, then press Ctrl+C. Text is not selectable unless it opts in, so a label that happens to sit under the pointer keeps behaving like a label."
								role:       "bodyMedium"
								wrap:       true
								selectable: true
								width:      { base: 280, md: 420 }
							}
						}

						// ---- theme: the same switch as the one at the bottom of the
						// rail. Both drive one piece of app state.
						Column {
							spacing: 8

							Text {
								text: "Theme"
								role: "titleMedium"
							}

							Switch {
								id:    darkSwitch
								label: "Dark mode"
								width: 220
							}

							Text {
								text:  "Every colour comes from the M3 scheme, so the whole page follows: surfaces, text, icons and state layers."
								role:  "bodySmall"
								wrap:  true
								width: { base: 280, md: 420 }
							}
						}
					}

					// ============================================== motion
					Column {
						id:             pageMotion
						visible:        false
						scroll:         true
						spacing:        24
						padding:        { base: 16, md: 24, lg: 32, xl: 64 }
						crossAxisAlign: start

						Column {
							spacing: 10

							Text {
								text: "Easing"
								role: "titleMedium"
							}

							Text {
								text:  "One distance, three curves. Linear keeps a constant speed, Standard starts fast and lands soft, Emphasized is slow at both ends. Press Play to run them together."
								role:  "bodySmall"
								wrap:  true
								width: { base: 280, md: 420 }
							}

							Column {
								width:   300
								spacing: 14

								Column {
									spacing: 4

									Text {
										text: "Linear"
										role: "labelMedium"
									}

									Stack {
										height: 36

										Positioned {
											left:       0
											right:      0
											top:        16
											height:     4
											background: surfaceContainerHighest
											radius:     2
										}

										Positioned {
											id:     dotLinear
											left:   0
											top:    0
											width:  36
											height: 36

											Rectangle {
												width:      36
												height:     36
												radius:     18
												background: primary
											}
										}
									}
								}

								Column {
									spacing: 4

									Text {
										text: "Standard"
										role: "labelMedium"
									}

									Stack {
										height: 36

										Positioned {
											left:       0
											right:      0
											top:        16
											height:     4
											background: surfaceContainerHighest
											radius:     2
										}

										Positioned {
											id:     dotStandard
											left:   0
											top:    0
											width:  36
											height: 36

											Rectangle {
												width:      36
												height:     36
												radius:     18
												background: primary
											}
										}
									}
								}

								Column {
									spacing: 4

									Text {
										text: "Emphasized"
										role: "labelMedium"
									}

									Stack {
										height: 36

										Positioned {
											left:       0
											right:      0
											top:        16
											height:     4
											background: surfaceContainerHighest
											radius:     2
										}

										Positioned {
											id:     dotEmphasized
											left:   0
											top:    0
											width:  36
											height: 36

											Rectangle {
												width:      36
												height:     36
												radius:     18
												background: primary
											}
										}
									}
								}
							}

							Button {
								id:    playEasing
								label: "Play"
								icon:  play_arrow
							}
						}

						Column {
							spacing: 10

							Text {
								text: "Value"
								role: "titleMedium"
							}

							Text {
								text:  "app.Animate moves any numeric Prop, so a slider and a progress ring follow the same tween without a special animation API."
								role:  "bodySmall"
								wrap:  true
								width: { base: 280, md: 420 }
							}

							Row {
								spacing: 24

								Slider {
									id:    motionSlider
									value: 0.25
									width: 240
								}

								CircularProgress {
									id:     motionProgress
									value:  0.3
									width:  64
									height: 64
								}
							}

							Button {
								id:      playValue
								label:   "Animate value"
								icon:    play_arrow
								variant: tonal
							}
						}
					}
				}

				// ---- compact: bottom bar
				NavigationBar {
					id:      navbar
					visible: { base: true, sm: false }

					NavigationItem {
						label:    "Buttons"
						icon:     smart_button
						selected: true
					}

					NavigationItem {
						label: "Inputs"
						icon:  tune
					}

					NavigationItem {
						label: "Surfaces"
						icon:  layers
					}

					NavigationItem {
						label: "Feedback"
						icon:  notifications
					}

					NavigationItem {
						label: "Layout"
						icon:  dashboard
					}

					NavigationItem {
						label: "Motion"
						icon:  animation
					}
				}
			}
		}

		// ---- modal drawer: the same categories, for when a bar or rail is out of
		// reach, plus the overlay pattern itself.
		Rectangle {
			id:         scrim
			background: #00000052
			visible:    false
		}

		Positioned {
			id:      drawerFrame
			left:    0
			top:     0
			bottom:  0
			width:   320
			visible: false

			NavigationDrawer {
				label: "Categories"

				NavigationItem {
					id:       drawerButtons
					label:    "Buttons"
					icon:     smart_button
					selected: true
				}

				NavigationItem {
					id:    drawerInputs
					label: "Inputs"
					icon:  tune
				}

				NavigationItem {
					id:    drawerSurfaces
					label: "Surfaces"
					icon:  layers
				}

				NavigationItem {
					id:    drawerFeedback
					label: "Feedback"
					icon:  notifications
				}

				NavigationItem {
					id:    drawerLayout
					label: "Layout"
					icon:  dashboard
				}

				NavigationItem {
					id:    drawerMotion
					label: "Motion"
					icon:  animation
				}

				// Same place a rail keeps its own actions: pinned to the bottom,
				// after a spacer, so the list can grow above it.
				Rectangle {
					flex: 1
				}

				Switch {
					id:           drawerTheme
					label:        "Dark mode"
					checked:      app.dark
					iconOn:       dark_mode
					iconOff:      light_mode
					marginLeft:   12
					marginRight:  12
					marginBottom: 16
				}
			}
		}
	}
}
