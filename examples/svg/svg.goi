// SVG: one file, any colour. currentColor in the file is replaced by the
// element's color, so the same icon follows a theme role or a Go property.
//
// Run with: go run -ldflags=-linkmode=internal ./examples/svg

bridge {
	Pick func(index int)
}

Window {
	id:     main
	title:  "SVG"
	theme:  app.systemMode
	width:  500
	height: 740

	Column {
		spacing: 0

		TopAppBar {
			label: "SVG"
		}

		Column {
			flex:           1
			padding:        24
			spacing:        24
			crossAxisAlign: center

			Card {
				width:   440
				variant: filled

				Column {
					spacing:        16
					crossAxisAlign: center

					Text {
						text: "currentColor follows the design"
						role: "titleMedium"
					}

					Row {
						spacing: 24

						SVG {
							src:    "star.svg"
							color:  primary
							width:  48
							height: 48
						}

						SVG {
							src:    "star.svg"
							color:  tertiary
							width:  48
							height: 48
						}

						SVG {
							src:    "star.svg"
							color:  error
							width:  48
							height: 48
						}
					}

					Text {
						text: "The same file three times, three roles."
						role: "bodySmall"
					}
				}
			}

			Card {
				width:   440
				variant: outlined

				Column {
					spacing:        16
					crossAxisAlign: center

					Text {
						text: "Set the colour from Go"
						role: "titleMedium"
					}

					SVG {
						id:     live
						src:    "star.svg"
						color:  primary
						width:  72
						height: 72
					}

					Text {
						id:   liveColor
						text: "primary"
						role: "labelMedium"
					}

					Row {
						spacing: 8

						Button {
							label:   "Primary"
							onClick: bridge.Pick(0)
						}

						Button {
							label:   "Tertiary"
							onClick: bridge.Pick(1)
						}

						Button {
							label:   "Error"
							onClick: bridge.Pick(2)
						}
					}
				}
			}

			Card {
				width:   440
				variant: outlined

				Column {
					spacing:        16
					crossAxisAlign: center

					Text {
						text: "Remote src"
						role: "titleMedium"
					}

					// A URL works like Image: the box shows a breathing
					// placeholder until the file lands, and the viewBox sizes
					// the icon when width and height are omitted.
					SVG {
						src:        "https://raw.githubusercontent.com/goi-gui/goi/master/examples/gallery/star.svg"
						color:      secondary
						width:      64
						height:     64
						background: surfaceContainerHighest
						radius:     12
					}

					Text {
						text:  "Fetched in the background, then rasterized. Width and height here are declared, so layout never waits for the network."
						role:  "bodySmall"
						wrap:  true
						width: { base: 280, md: 360 }
					}
				}
			}
		}
	}
}
