// The counter example window.
Window {
	id: main
	title: "Counter"
	width: 480
	height: 360
	background: #FEF7FF

	Column {
		padding: 24
		spacing: 16
		align: center

		Text {
			id: label
			text: "0"
			role: displayLarge
			color: #6750A4
		}

		Row {
			spacing: 8
			align: center
			Button {
				id: inc
				label: "Increase"
				icon: add
			}
			Button {
				id: reset
				label: "Reset"
				variant: tonal
			}
		}

		TextField {
			id: name
			label: "Your name"
			placeholder: "Type here"
			variant: outlined
			width: 260
		}
	}
}
