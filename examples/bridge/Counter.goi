// Counter: a fragment that owns none of its state. The instance passes the
// value it shows and the handler its buttons call, so this file never mentions
// `bridge` at all.

props {
	Label  string
	Count  int
	OnStep func(delta int)
}

Card {
	variant: filled

	Column {
		spacing: 10

		Text {
			text: formatf("%s: %d", props.Label, props.Count)
			role: "titleMedium"
		}

		Row {
			spacing: 8

			Button {
				label:   "-1"
				variant: tonal
				onClick: props.OnStep(-1)
			}

			Button {
				label:   "+1"
				onClick: props.OnStep(1)
			}

			Button {
				label:   "+10"
				variant: tonal
				onClick: props.OnStep(10)
			}
		}
	}
}
