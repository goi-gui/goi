// Sidebar: a navigation panel. The three props let each instance say what it
// shows; everything else (width, visible, ...) is an ordinary property the
// instance can override.

props {
	title    string
	subtitle string
	active   string
}

Column {
	width:      280
	padding:    12
	spacing:    6
	background: surfaceContainer

	Text {
		text: props.title
		role: "titleLarge"
	}

	Text {
		text:  props.subtitle
		role:  "bodySmall"
		color: onSurfaceVariant
	}

	// An empty rectangle draws nothing but still reserves its height, which is
	// the smallest way to open a gap that spacing alone cannot express.
	Rectangle {
		height: 8
	}

	NavigationItem {
		label:    "Inbox"
		icon:     inbox
		selected: true
	}

	NavigationItem {
		label: "Starred"
		icon:  star
	}

	NavigationItem {
		label: "Sent"
		icon:  send
	}

	NavigationItem {
		label: "Trash"
		icon:  delete
	}

	Divider {}

	Text {
		text:  "Active: "
		role:  "labelSmall"
		color: onSurfaceVariant
	}

	Text {
		text: props.active
		role: "labelMedium"
	}
}
