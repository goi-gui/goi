// Second gallery page: containers, overlays, pickers and navigation.
Window {
	id: main
	title: "Material 3 overlays"
	theme: light
	background: #FEF7FF

	Row {
		spacing: 0
		flex: 1

		// ---- rail
		NavigationRail {
			NavigationItem { label: "Home" icon: home selected: true }
			NavigationItem { label: "Explore" icon: explore }
			NavigationItem { label: "Settings" icon: settings }
		}

		// ---- drawer
		NavigationDrawer {
			label: "Mail"
			width: 260
			NavigationItem { label: "Inbox" icon: inbox selected: true }
			NavigationItem { label: "Starred" icon: star }
			NavigationItem { label: "Sent" icon: send }
			NavigationItem { label: "Trash" icon: delete }
			Divider { }
			NavigationItem { label: "Settings" icon: settings }
		}

		// ---- content
		Column {
			spacing: 16
			flex: 1
			padding: 16
			align: start

			Text { text: "FAB menu, button group, toolbar" role: "titleMedium" color: #49454F }
			Row {
				spacing: 16
				align: center
				FABMenu { icon: add expanded: true width: 56 height: 56 }
				ButtonGroup {
					spacing: 8
					Button { label: "Cut" icon: content_cut variant: tonal }
					Button { label: "Copy" icon: content_copy variant: tonal }
					Button { label: "Paste" icon: content_paste variant: tonal }
				}
			}
			Toolbar {
				width: 320
				Row {
					spacing: 4
					align: center
					padding: 8
					IconButton { icon: format_bold }
					IconButton { icon: format_italic }
					IconButton { icon: format_underlined }
					IconButton { icon: format_align_left selected: true variant: tonal }
				}
			}

			Text { text: "Date and time pickers" role: "titleMedium" color: #49454F }
			Row {
				spacing: 16
				DatePicker { label: "Select date" width: 300 height: 340 }
				TimePicker { label: "10:15" width: 300 height: 340 }
			}

			Text { text: "Carousel" role: "titleMedium" color: #49454F }
			Carousel {
				width: 640
				height: 140
				Row {
					spacing: 12
					Card { width: 200 height: 130 variant: filled label: "One" }
					Card { width: 200 height: 130 variant: elevated label: "Two" }
					Card { width: 200 height: 130 variant: outlined label: "Three" }
				}
			}

			Text { text: "Dialog, sheets, snackbar" role: "titleMedium" color: #49454F }
			Row {
				spacing: 16
				align: start
				Dialog { label: "Reset settings?" supporting: "This cannot be undone." width: 280 height: 160 }
				Column {
					spacing: 12
					BottomSheet { label: "Bottom sheet" width: 280 height: 130 }
					Snackbar { label: "Message sent" width: 280 }
					Tooltip { label: "Tooltip" width: 90 }
				}
			}
		}
	}
}
