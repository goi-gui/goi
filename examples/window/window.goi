// Window properties: the size limits, disabling the user's resize, and
// fullscreen. Each switch is a normal .goi property, so it can come from an
// expression as well as from the literal below.
//
// Run with: go run -ldflags=-linkmode=internal ./examples/window

bridge {
	// The size limits read these, so setting one from Go resizes the window on
	// the next frame. -1 means "no limit".
	MinW        float64
	MaxW        float64
	SetMin      func()
	ClearLimits func()
}

Window {
	id:            main
	title:         "Window"
	width:         760
	height:        620
	minWidth:      bridge.MinW
	minHeight:     360
	maxWidth:      bridge.MaxW
	maxHeight:     900
	disableResize: false
	fullscreen:    false
	theme:         app.systemMode

	Column {
		spacing: 0

		TopAppBar {
			label: "Window"
		}

		Column {
			flex:           1
			padding:        24
			spacing:        20
			crossAxisAlign: center

			Card {
				width:   520
				variant: filled

				Column {
					spacing: 12

					Text {
						text: "Size limits"
						role: "titleMedium"
					}

					Text {
						text: "minWidth 420 · minHeight 360 · maxWidth 1100 · maxHeight 900. Drag this window's edge and it stops at those bounds."
						role: "bodySmall"
						wrap: true
					}

					Row {
						spacing: 8

						Chip {
							label: "min 420×360"
						}

						Chip {
							label: "max 1100×900"
						}
					}
				}
			}

			Card {
				width:   520
				variant: outlined

				Column {
					spacing: 12

					Text {
						text: "Resize and fullscreen"
						role: "titleMedium"
					}

					Switch {
						id:    lockResize
						label: "Disable resize"
					}

					Switch {
						id:    fs
						label: "Fullscreen"
					}

					Text {
						id:   status
						text: "resize on · windowed"
						role: "bodySmall"
					}
				}
			}

			Card {
				width:   520
				variant: outlined

				Column {
					spacing: 12

					Text {
						text: "From Go"
						role: "titleMedium"
					}

					Text {
						text: "Window properties are reactive: setting them from Go reaches the platform on the next frame, no reload needed."
						role: "bodySmall"
						wrap: true
					}

					Row {
						spacing: 8

						Button {
							label:   "Set min 600×500"
							onClick: bridge.SetMin()
						}

						Button {
							label:   "Clear limits"
							onClick: bridge.ClearLimits()
						}
					}
				}
			}
		}
	}
}
