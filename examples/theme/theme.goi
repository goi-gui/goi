// Theme: pick a scheme by name and see every role follow it.
Window {
	id: main
	title: "Theme"
	width: 560
	height: 740

	Column {
		spacing: 0

		TopAppBar { label: "Theme" }

		Column {
			flex: 1
			padding: 24
			spacing: 20
			align: center

			Card {
				width: 440
				variant: filled

				Column {
					spacing: 16
					align: center

					Text { text: "Colour scheme" role: "titleMedium" }
					Row {
						width: 300
						alignSelf: center
						SegmentedButton { id: segLight label: "Light" width: 100 variant: single selected: true }
						SegmentedButton { id: segDark label: "Dark" width: 100 variant: single }
						SegmentedButton { id: segBrand label: "Brand" width: 100 variant: single }
					}
					Row {
						spacing: 6
						align: center
						Text { text: "Active:" role: "bodySmall" }
						Text { id: current text: "light" role: "labelLarge" color: primary }
					}
					Switch { id: darkSwitch label: "Dark mode" }
				}
			}

			// Every colour below is a role, so the whole page follows the scheme.
			Card {
				width: 440

				Column {
					spacing: 12
					paddingBottom: 12

					Text { text: "Roles" role: "titleSmall" }

					Row {
						spacing: 8
						Rectangle { width: 64 height: 32 radius: 8 background: primary }
						Rectangle { width: 64 height: 32 radius: 8 background: primaryContainer }
						Rectangle { width: 64 height: 32 radius: 8 background: secondaryContainer }
						Rectangle { width: 64 height: 32 radius: 8 background: tertiaryContainer }
						Rectangle { width: 64 height: 32 radius: 8 background: errorContainer }
					}

					Divider { }

					Row {
						spacing: 12
						align: center
						IconButton { id: add icon: add variant: filled }
						Text { id: count text: "0" role: "headlineMedium" }
					}
					Button { label: "Filled" }
					Button { label: "Tonal" variant: tonal }
					Button { label: "Outlined" variant: outlined }
					TextField { label: "A field" supporting: "Roles follow the scheme." }
				}
			}
		}
	}
}
