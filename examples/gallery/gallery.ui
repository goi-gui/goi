// The Material 3 component gallery, split into one page per category.
//
// Navigation follows the M3 window size classes: a bottom navigation bar in the
// compact layout, a navigation rail from 640dp up. The app-bar menu opens a
// modal drawer that lists the same categories, so the pattern works even when a
// bar or rail is off screen.
//
// Every page is an independent scrolling column; Go shows one at a time.
Window {
	id: main
	title: "Material 3 components"
	theme: light

	Stack {
		Row {
			spacing: 0

			// ---- medium and expanded: rail
			NavigationRail {
				id: rail
				visible: { base: false, sm: true }
				NavigationItem { label: "Buttons" icon: smart_button selected: true }
				NavigationItem { label: "Inputs" icon: tune }
				NavigationItem { label: "Surfaces" icon: layers }
				NavigationItem { label: "Feedback" icon: notifications }
				NavigationItem { label: "Layout" icon: dashboard }
				NavigationItem { label: "Motion" icon: animation }
			}

			Column {
				spacing: 0
				flex: 1

				TopAppBar {
					id: appbar
					label: "Buttons"
					icon: "menu"
					// An expression, not Go state: the icon follows the theme
					// wherever the theme is changed from.
					trailingIcon: app.dark ? "light_mode" : "dark_mode"
				}

				// ---- one page at a time
				Stack {
					flex: 1

					// ============================================== buttons
					Column {
						id: pageButtons
						scroll: true
						spacing: 24
						padding: { base: 16, md: 24, lg: 32, xl: 64 }
						align: start

						Column {
							spacing: 10
							Text { text: "Buttons" role: "titleMedium" }
							Wrap {
								spacing: 8
								Button { label: "Filled" }
								Button { label: "Tonal" variant: tonal }
								Button { label: "Outlined" variant: outlined }
								Button { label: "Text" variant: text }
								Button { label: "Elevated" variant: elevated }
								Button { label: "With icon" icon: add }
								Button { label: "Disabled" disabled: true }
							}
						}

						Column {
							spacing: 10
							Text { text: "Icon buttons" role: "titleMedium" }
							Wrap {
								spacing: 8
								IconButton { icon: favorite }
								IconButton { icon: favorite variant: filled }
								IconButton { icon: favorite variant: tonal }
								IconButton { icon: favorite variant: outlined }
							}
						}

						Column {
							spacing: 10
							Text { text: "FAB" role: "titleMedium" }
							Wrap {
								spacing: 16
								FAB { icon: edit size: sm }
								FAB { icon: add }
								FAB { label: "Compose" icon: edit variant: extended }
							}
						}

						Column {
							spacing: 10
							Text { text: "Split button" role: "titleMedium" }
							SplitButton { label: "Split" icon: add width: 200 }
						}

						Column {
							spacing: 10
							Text { text: "Segmented button: radio" role: "titleMedium" }
							Row {
								spacing: 0
								SegmentedButton { label: "Day" width: 84 variant: single }
								SegmentedButton { label: "Week" width: 84 variant: single selected: true }
								SegmentedButton { label: "Month" width: 96 variant: single }
							}
							Text {
								text: "variant: single keeps exactly one selected."
								role: "bodySmall"
							}
						}

						Column {
							spacing: 10
							Text { text: "Segmented button: checkbox" role: "titleMedium" }
							Row {
								spacing: 0
								SegmentedButton { label: "Bold" width: 84 }
								SegmentedButton { label: "Italic" width: 84 selected: true }
								SegmentedButton { label: "Underline" width: 108 }
							}
							Text {
								text: "The default toggles each segment on its own; clicking a selected one clears it."
								role: "bodySmall"
							}
						}
					}

					// =============================================== inputs
					Column {
						id: pageInputs
						visible: false
						scroll: true
						spacing: 24
						padding: { base: 16, md: 24, lg: 32, xl: 64 }
						align: start

						Column {
							spacing: 10
							Text { text: "Selection" role: "titleMedium" }
							Checkbox { id: check label: "Checkbox" checked: true width: 220 }
							RadioButton { label: "Radio button" checked: true width: 220 }
							Switch { id: switchOn label: "Switch" checked: true width: 220 }
						}

						Column {
							spacing: 10
							Text { text: "Slider" role: "titleMedium" }
							Slider { id: slider value: 0.4 min: 0 max: 1 width: { base: 280, md: 360 } }
							Text { text: "Drag the handle, or use the arrow keys." role: "bodySmall" }
						}

						Column {
							spacing: 10
							Text { text: "Chips" role: "titleMedium" }
							Wrap {
								spacing: 8
								Chip { label: "Assist" icon: event }
								Chip { label: "Filter" variant: filter selected: true }
								Chip { label: "Input" variant: input }
								Chip { label: "Suggestion" variant: suggestion }
							}
						}

						Column {
							spacing: 10
							Text { text: "Text fields" role: "titleMedium" }
							TextField {
								id: field
								label: "Label"
								placeholder: "Filled text field"
								variant: filled
								width: { base: 280, md: 360 }
							}
							TextField {
								label: "Label"
								placeholder: "Outlined field"
								variant: outlined
								width: { base: 280, md: 360 }
							}
							TextField {
								label: "Email"
								text: "user@example.com"
								icon: mail
								variant: filled
								width: { base: 280, md: 360 }
							}
							TextField {
								label: "Supporting text"
								placeholder: "With a helper line"
								supporting: "Shown under the field"
								variant: outlined
								width: { base: 280, md: 360 }
							}
						}

						Column {
							spacing: 10
							Text { text: "Search bar" role: "titleMedium" }
							SearchBar { placeholder: "Search components" width: { base: 280, md: 400 } }
							Text { text: "Click it and type: the value scrolls and selects." role: "bodySmall" }
						}
					}

					// ============================================= surfaces
					Column {
						id: pageSurfaces
						visible: false
						scroll: true
						spacing: 24
						padding: { base: 16, md: 24, lg: 32, xl: 64 }
						align: start

						Column {
							spacing: 12
							Text { text: "Cards" role: "titleMedium" }
							Grid {
								columns: { base: 1, md: 2, lg: 3 }
								spacing: 12
								Card {
									label: "Elevated"
									supporting: "Surface container low"
									height: 96
								}
								Card {
									label: "Filled"
									supporting: "Highest container"
									variant: filled
									height: 96
								}
								Card {
									label: "Outlined"
									supporting: "1dp outline"
									variant: outlined
									height: 96
								}
							}
						}

						Column {
							spacing: 10
							Text { text: "Image" role: "titleMedium" }
							Wrap {
								spacing: 12
								// cover crops to fill the box; contain letterboxes.
								Image {
									src: "sample.png"
									width: 180
									height: 120
									radius: 12
								}
								Image {
									src: "sample.png"
									fit: contain
									width: 180
									height: 120
									radius: 12
									background: surfaceContainerHigh
								}
								Image {
									src: "sample.png"
									fit: fill
									width: 180
									height: 120
									radius: 12
								}
							}
							Text {
								text: "PNG, JPEG and GIF, decoded once and packed into one GPU atlas. fit picks cover, contain or fill."
								role: "bodySmall"
								wrap: true
								width: { base: 280, md: 420 }
							}
						}

						Column {
							spacing: 10
							Text { text: "List" role: "titleMedium" }
							List {
								width: { base: 100%, md: 420 }
								ListItem { label: "List item" icon: person trailingIcon: chevron_right }
								ListItem { label: "Two lines" supporting: "Supporting text" icon: photo }
								Divider { }
								ListItem { label: "Selected" icon: star selected: true }
							}
						}

						Column {
							spacing: 10
							Text { text: "Tabs" role: "titleMedium" }
							Tabs {
								width: { base: 100%, md: 420 }
								Tab { label: "Overview" selected: true }
								Tab { label: "Specs" }
								Tab { label: "Details" }
							}
						}

						Column {
							spacing: 10
							Text { text: "Menu" role: "titleMedium" }
							Menu {
								width: 260
								MenuItem { label: "Cut" icon: content_cut }
								MenuItem { label: "Copy" icon: content_copy }
								MenuItem { label: "Paste" icon: content_paste }
								Divider { }
								MenuItem { label: "More…" icon: more_horiz }
							}
						}
					}

					// ============================================= feedback
					Column {
						id: pageFeedback
						visible: false
						scroll: true
						spacing: 24
						padding: { base: 16, md: 24, lg: 32, xl: 64 }
						align: start

						Column {
							spacing: 10
							Text { text: "Progress" role: "titleMedium" }
							LinearProgress { value: 0.6 width: { base: 280, md: 420 } }
							Row {
								spacing: 24
								align: center
								CircularProgress { value: 0.65 }
								LoadingIndicator { }
							}
						}

						Column {
							spacing: 10
							Text { text: "Badges" role: "titleMedium" }
							Wrap {
								spacing: 16
								Badge { }
								Badge { label: "12" }
								Badge { label: "99+" }
							}
						}

						Column {
							spacing: 10
							Text { text: "Dialog and sheets" role: "titleMedium" }
							Wrap {
								spacing: 16
								Dialog {
									label: "Reset settings?"
									supporting: "This cannot be undone."
									width: 280
									height: 168
								}
								Column {
									spacing: 12
									BottomSheet { label: "Bottom sheet" width: 280 height: 132 }
									SideSheet { label: "Side sheet" width: 280 height: 132 }
								}
							}
						}

						Column {
							spacing: 10
							Text { text: "Snackbar and tooltip" role: "titleMedium" }
							Snackbar { label: "Saved to your library" width: { base: 280, md: 420 } }
							Tooltip { label: "Tooltip text" width: 120 }
						}
					}

					// =============================================== layout
					Column {
						id: pageLayout
						visible: false
						scroll: true
						spacing: 24
						padding: { base: 16, md: 24, lg: 32, xl: 64 }
						align: start

						Column {
							spacing: 12
							Text { text: "Grid" role: "titleMedium" }
							Grid {
								columns: { base: 1, sm: 2, lg: 3 }
								spacing: 12
								Card { label: "One" supporting: "base: 1 column" height: 88 variant: filled }
								Card { label: "Two" supporting: "sm: 2 columns" height: 88 }
								Card { label: "Three" supporting: "lg: 3 columns" height: 88 variant: outlined }
							}
						}

						Column {
							spacing: 10
							Text { text: "Wrap" role: "titleMedium" }
							Wrap {
								spacing: 8
								Chip { label: "Wrap" icon: event }
								Chip { label: "Second" }
								Chip { label: "Third" }
								Chip { label: "Fourth" }
								Chip { label: "Fifth" }
								Chip { label: "Sixth" }
							}
						}

						Column {
							spacing: 10
							Text { text: "Stack and positioned" role: "titleMedium" }
							Stack {
								width: { base: 280, md: 420 }
								height: 200
								// A Card rather than a coloured Rectangle: the plate
								// has to follow the theme, and a Card is the M3
								// surface that does.
								Card {
									variant: filled
									radius: 16
								}
								Positioned {
									left: 16
									top: 16
									Card { label: "left: 16" supporting: "top: 16" width: 190 height: 84 variant: filled }
								}
								Positioned {
									right: 16
									bottom: 16
									Chip { label: "bottom right" icon: star }
								}
								Positioned {
									left: 16
									right: 16
									bottom: 64
									height: 4
									background: primary
									radius: 2
								}
							}
						}

						Column {
							spacing: 10
							Text { text: "Expressions" role: "titleMedium" }
							Column {
								width: 320
								spacing: 8
								// Named roles instead of hex: these follow the scheme.
								Rectangle { id: demoBase width: 240 height: 10 background: primary radius: 5 }
								Rectangle { width: demoBase.width / 2 height: 10 background: secondary radius: 5 }
								Rectangle { width: 50% height: 10 background: tertiary radius: 5 }
							}
							Column {
								spacing: 6
								Text {
									text: app.dark ? "Conditional: the dark scheme is active." : "Conditional: the light scheme is active."
									role: "bodyMedium"
								}
								Rectangle {
									width: 160
									height: 8
									radius: 4
									background: app.dark ? primaryContainer : inversePrimary
								}
							}
							Text {
								text: "A reference, a division, a comparison, a conditional and a percentage of the parent."
								role: "bodySmall"
								wrap: true
							}
						}

						Column {
							spacing: 10
							Text { text: "Visibility" role: "titleMedium" }
							Text {
								text: "This line appears from sm (640dp) up."
								role: "bodyMedium"
								visible: { base: false, sm: true }
							}
							Text {
								text: "This one only below sm, and the layout closes the gap."
								role: "bodyMedium"
								visible: { base: true, sm: false }
							}
						}

						Column {
							spacing: 8
							Text { text: "Type" role: "titleMedium" }
							Text { text: "Headline medium" role: "headlineMedium" }
							Text { text: "Title large, weight 900" role: "titleLarge" weight: 900 }
							Text { text: "Body large at 300" role: "bodyLarge" weight: 300 }
							Text {
								text: "Body medium wraps when the column runs out, and the block reserves one line box for every line it draws. Resize the window to watch it reflow."
								role: "bodyMedium"
								wrap: true
								width: { base: 280, md: 420, lg: 560 }
							}
						}

						// ---- repeat: one hidden template, copies added from Go.
						Column {
							spacing: 8
							Text { text: "Repeat" role: "titleMedium" }
							Column {
								id: repeatList
								spacing: 6
								width: { base: 280, md: 420 }
								ListItem {
									id: repeatTemplate
									visible: false
									label: "Item"
									icon: circle
								}
							}
							Text {
								text: "Three copies built with ui.Instantiate; the template itself stays hidden."
								role: "bodySmall"
								wrap: true
								width: { base: 280, md: 420 }
							}
						}

						Column {
							spacing: 8
							Text { text: "Selectable text" role: "titleMedium" }
							Text {
								id: selectableText
								text: "Drag across this paragraph to select it, then press Ctrl+C. Text is not selectable unless it opts in, so a label that happens to sit under the pointer keeps behaving like a label."
								role: "bodyMedium"
								wrap: true
								selectable: true
								width: { base: 280, md: 420 }
							}
						}

						// ---- theme: the same switch as the app-bar icon, for
						// discoverability. Both drive one piece of app state.
						Column {
							spacing: 8
							Text { text: "Theme" role: "titleMedium" }
							Switch {
								id: darkSwitch
								label: "Dark mode"
								width: 220
							}
							Text {
								text: "Every colour comes from the M3 scheme, so the whole page follows: surfaces, text, icons and state layers."
								role: "bodySmall"
								wrap: true
								width: { base: 280, md: 420 }
							}
						}
					}
				}

					// ============================================== motion
					Column {
						id: pageMotion
						visible: false
						scroll: true
						spacing: 24
						padding: { base: 16, md: 24, lg: 32, xl: 64 }
						align: start

						Column {
							spacing: 10
							Text { text: "Easing" role: "titleMedium" }
							Text {
								text: "One distance, three curves. Linear keeps a constant speed, Standard starts fast and lands soft, Emphasized is slow at both ends. Press Play to run them together."
								role: "bodySmall"
								wrap: true
								width: { base: 280, md: 420 }
							}
							Column {
								width: 300
								spacing: 14
								Column {
									spacing: 4
									Text { text: "Linear" role: "labelMedium" }
									Stack {
										height: 36
										Positioned { left: 0 right: 0 top: 16 height: 4 background: surfaceContainerHighest radius: 2 }
										Positioned {
											id: dotLinear
											left: 0
											top: 0
											width: 36
											height: 36
											Rectangle { width: 36 height: 36 radius: 18 background: primary }
										}
									}
								}
								Column {
									spacing: 4
									Text { text: "Standard" role: "labelMedium" }
									Stack {
										height: 36
										Positioned { left: 0 right: 0 top: 16 height: 4 background: surfaceContainerHighest radius: 2 }
										Positioned {
											id: dotStandard
											left: 0
											top: 0
											width: 36
											height: 36
											Rectangle { width: 36 height: 36 radius: 18 background: primary }
										}
									}
								}
								Column {
									spacing: 4
									Text { text: "Emphasized" role: "labelMedium" }
									Stack {
										height: 36
										Positioned { left: 0 right: 0 top: 16 height: 4 background: surfaceContainerHighest radius: 2 }
										Positioned {
											id: dotEmphasized
											left: 0
											top: 0
											width: 36
											height: 36
											Rectangle { width: 36 height: 36 radius: 18 background: primary }
										}
									}
								}
							}
							Button { id: playEasing label: "Play" icon: play_arrow }
						}

						Column {
							spacing: 10
							Text { text: "Value" role: "titleMedium" }
							Text {
								text: "app.Animate moves any numeric Prop, so a slider and a progress ring follow the same tween without a special animation API."
								role: "bodySmall"
								wrap: true
								width: { base: 280, md: 420 }
							}
							Row {
								spacing: 24
								Slider { id: motionSlider value: 0.25 width: 240 }
								CircularProgress { id: motionProgress value: 0.3 width: 64 height: 64 }
							}
							Button { id: playValue label: "Animate value" icon: play_arrow variant: tonal }
						}
					}

				// ---- compact: bottom bar
				NavigationBar {
					id: navbar
					visible: { base: true, sm: false }
					NavigationItem { label: "Buttons" icon: smart_button selected: true }
					NavigationItem { label: "Inputs" icon: tune }
					NavigationItem { label: "Surfaces" icon: layers }
					NavigationItem { label: "Feedback" icon: notifications }
					NavigationItem { label: "Layout" icon: dashboard }
					NavigationItem { label: "Motion" icon: animation }
				}
			}
		}

		// ---- modal drawer: the same categories, for when a bar or rail is out of
		// reach, plus the overlay pattern itself.
		Rectangle { id: scrim background: #00000052 visible: false }
		Positioned {
			id: drawerFrame
			left: 0
			top: 0
			bottom: 0
			width: 320
			visible: false
			NavigationDrawer {
				label: "Categories"
				NavigationItem { id: drawerButtons label: "Buttons" icon: smart_button selected: true }
				NavigationItem { id: drawerInputs label: "Inputs" icon: tune }
				NavigationItem { id: drawerSurfaces label: "Surfaces" icon: layers }
				NavigationItem { id: drawerFeedback label: "Feedback" icon: notifications }
				NavigationItem { id: drawerLayout label: "Layout" icon: dashboard }
				NavigationItem { id: drawerMotion label: "Motion" icon: animation }
			}
		}
	}
}
